FROM python:3.12-slim AS builder

WORKDIR /app
COPY mcp-server/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


FROM python:3.12-slim

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy MCP server files
COPY mcp-server/mcp_server.py .

# Health check - verify MCP server port is listening (fastmcp SSE doesn't have /health endpoint)
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import socket; s=socket.socket(); s.settimeout(5); s.connect(('localhost', 8095)); s.close()" || exit 1

EXPOSE 8095

CMD ["python", "mcp_server.py", "--base-url=http://wiki4ai-backend:8080/api", "--transport=sse", "--port=8095"]
